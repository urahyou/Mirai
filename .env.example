# Copy this file to .env and add only the keys required by your Providers.
# .env is ignored by Git and must never be committed.

MIRAI_PROVIDER_DEEPSEEK_API_KEY=
MIRAI_PROVIDER_OLLAMA_MAC_API_KEY=

# ---- 语音侧车（可选） ----
# 默认 TTS = edge（edge-tts 云合成，需联网）。要改用本地 GPT-SoVITS 音色克隆（离线，路线A零样本）：
# 1) 先在本机跑起服务：cd ~/GPT-SoVITS && .venv/bin/python api_v2.py -a 127.0.0.1 -p 9880 -c GPT_SoVITS/configs/tts_infer_mac.yaml
# 2) 再取消下面注释并填参考音频路径（一段 ~10s 干净人声）：
#SIDECAR_TTS_ENGINE=gpt-sovits
#SIDECAR_TTS_URL=http://127.0.0.1:9880/
#SIDECAR_TTS_REF_WAV=/绝对/路径/参考音频.mp3
#SIDECAR_TTS_PROMPT_TEXT=参考音频对应的台词（日文参考通常必填）
#SIDECAR_TTS_PROMPT_LANG=ja
#SIDECAR_TTS_TEXT_LANGUAGE=zh
# 想让“中文回复、日语/外语朗读”：设 SPEAK_LANG 为 ja（或 en/ko…），并在下方 TEXT_LANGUAGE 保持一致同语言。
#SIDECAR_TTS_SPEAK_LANG=ja
# ---- SoVITS 中/日切换（可选）：让克隆版“小未来”既说中文又说日语 ----
# 给克隆引擎配一份日语参考（与中文参考不同语言）。面板切“朗读语言=日语”时，
# 侧车自动改用日语参考 + 日语标签说话；没有则回退中文直读（防串扰）。
#SIDECAR_TTS_REF_WAV_JA=/绝对/路径/日语参考.mp3
#SIDECAR_TTS_PROMPT_TEXT_JA=日语参考对应的日语台词
#SIDECAR_TTS_PROMPT_LANG_JA=ja
#SIDECAR_TTS_TEMPERATURE=0.9
#SIDECAR_TTS_SPEED_FACTOR=1.0

# ---- Qwen3TTS-Faster（推荐：中文更自然，吃角色参考即可，无需翻译） ----
# 引擎切 qwen3：本地多语言 TTS，中文直读、音色用 refer_wav 自配。
# 需先部署后端（scripts/setup-qwen-tts.js 下载解压），默认独立端口 9980（与 gpt-sovits 9880 并存，可双引擎切换）。
#SIDECAR_TTS_ENGINE=qwen3
#SIDECAR_QWEN3_URL=http://127.0.0.1:9980/
#SIDECAR_QWEN3_LORA_ID=            # 可选：若用某团 LoRA 声线（如 mygo_qwen3tts）；留空则用 REF_WAV 音色自配
#SIDECAR_TTS_REF_WAV=/绝对/路径/参考音频.mp3   # qwen3 也用它做音色克隆；此时 TEXT_LANGUAGE=zh 直接说中文，勿设 SPEAK_LANG
#SIDECAR_TTS_PROMPT_TEXT=参考音频对应的台词（若参考音频与文本匹配可改善音色）
#SIDECAR_TTS_TEXT_LANGUAGE=zh
# 不改引擎时，也可只在下面调 edge 音色：
#SIDECAR_TTS_VOICE=zh-CN-XiaoxiaoNeural
